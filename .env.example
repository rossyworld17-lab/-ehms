# Copy to .env and change every value marked CHANGE ME. Never commit .env.
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
EHMS_SECRET_KEY=CHANGE-ME-generate-with-python-c-import-secrets-print-secrets.token_urlsafe-48
EHMS_ENV=production
EHMS_ACCESS_TOKEN_MINUTES=30
EHMS_SESSION_IDLE_MINUTES=30
EHMS_MAX_FAILED_LOGINS=5
EHMS_LOCKOUT_MINUTES=15
EHMS_MIN_PASSWORD_LENGTH=10
# Set to 1 only on a demo/training server — loads fictional demo data
EHMS_SEED_DEMO=0
BACKUP_RETENTION_DAYS=14

# Email (booking confirmations, invoices, password resets). Leave blank to record messages as "not configured".
EHMS_SMTP_HOST=
EHMS_SMTP_PORT=587
EHMS_SMTP_USER=
EHMS_SMTP_PASSWORD=
EHMS_SMTP_FROM=reservations@your-hotel.com
EHMS_SMTP_TLS=1

# Payment gateways (integration point — see docs/DEPLOYMENT.md). Online payment stays disabled until configured.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
