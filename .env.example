# EHMS production settings. deploy/install.sh writes this file for you with random secrets.
# By hand: copy to .env, replace every CHANGE-ME, then run:  docker compose exec app python -m ehms.preflight
# NEVER commit .env. Keep a copy of EHMS_DATA_KEY offline (password manager / safe): without it the encrypted
# fields and every backup are unreadable.

# ---- address
# DNS A record → this server
EHMS_DOMAIN=ehms.your-hotel.com
# Let's Encrypt expiry notices
ACME_EMAIL=it@your-hotel.com
# used in emails, payment links and the Android app
EHMS_PUBLIC_URL=https://ehms.your-hotel.com

# ---- secrets (generate each one, never reuse)
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE-ME
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
EHMS_SECRET_KEY=CHANGE-ME
# python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
EHMS_DATA_KEY=CHANGE-ME

# ---- security policy
EHMS_ENV=production
# privileged | all | off  (two-step verification)
EHMS_REQUIRE_MFA=privileged
EHMS_ACCESS_TOKEN_MINUTES=30
EHMS_SESSION_IDLE_MINUTES=30
EHMS_MAX_FAILED_LOGINS=5
EHMS_LOCKOUT_MINUTES=15
EHMS_IP_MAX_FAILED_LOGINS=20
EHMS_MIN_PASSWORD_LENGTH=10
# 1 = publish the API reference at /api/docs
EHMS_API_DOCS=0
# published in /.well-known/security.txt
EHMS_SECURITY_CONTACT=security@your-hotel.com
# never 1 on a live hotel
EHMS_SEED_DEMO=0

# ---- website & Android app
# hotel code shown at the main address (default: first hotel)
EHMS_WEBSITE_HOTEL=
EHMS_APP_NAME=EHMS Staff
# e.g. ng.ehms.staff (see docs/ANDROID_APP.md)
EHMS_ANDROID_PACKAGE=
# upload key + Play App Signing fingerprints, comma-separated
EHMS_ANDROID_SHA256=

# ---- backups (encrypted with EHMS_DATA_KEY, verified by test restore, kept in the ehms-data volume)
EHMS_BACKUP_RETENTION_DAYS=14

# ---- email (confirmations, invoices, password resets). Blank = recorded as "not configured".
EHMS_SMTP_HOST=
EHMS_SMTP_PORT=587
EHMS_SMTP_USER=
EHMS_SMTP_PASSWORD=
EHMS_SMTP_FROM=reservations@your-hotel.com
EHMS_SMTP_TLS=1

# ---- SMS / WhatsApp (optional)
EHMS_TERMII_API_KEY=
EHMS_TERMII_SENDER=
EHMS_WHATSAPP_TOKEN=
EHMS_WHATSAPP_PHONE_ID=

# ---- online payments (optional; booking engine offers pay-at-hotel until set)
EHMS_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- integrations (optional): door locks / CCTV and fingerprint clocks post events with these tokens
EHMS_ACCESS_API_TOKEN=
EHMS_ATTENDANCE_API_TOKEN=

# ---- documents
EHMS_MAX_UPLOAD_MB=10

# ---- management assistant (optional external AI engine; aggregated figures only)
EHMS_AI_PROVIDER=
ANTHROPIC_API_KEY=
EHMS_AI_MODEL=claude-opus-5-5
